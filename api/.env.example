# Copie en .env pour le dev local (docker compose up -d fournit pg + redis).
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Doit matcher docker-compose.yml
DATABASE_URL=postgres://stone:stone@localhost:5432/stone_daily
REDIS_URL=redis://localhost:6379

# Secret de signature du token de session (>= 16 caractères). À changer en prod.
JWT_SECRET=dev-secret-change-me-please

# fs (dev/test) ou s3 (prod)
STORAGE_DRIVER=fs
STORAGE_FS_DIR=./.data/grids

# Requis seulement si STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=stone-daily-grids
# STORAGE_S3_PUBLIC_BASE=https://cdn.example.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
